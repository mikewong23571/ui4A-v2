{
  "schemaVersion": 1,
  "keycloakVersion": "26.7.1",
  "realm": {
    "name": "ui4a",
    "enabled": true
  },
  "protocolScopes": ["openid", "profile", "email"],
  "clientScopes": [
    { "name": "ui4a:read", "kind": "permission" },
    { "name": "ui4a:write", "kind": "permission" },
    { "name": "ui4a:approve", "kind": "permission" },
    { "name": "default", "kind": "policy" },
    { "name": "publishing", "kind": "policy" },
    { "name": "community", "kind": "policy" },
    { "name": "development", "kind": "policy" },
    { "name": "editorial", "kind": "policy" },
    { "name": "governance", "kind": "policy" }
  ],
  "clients": [
    {
      "clientId": "ui4a-web",
      "clientKind": "browser",
      "confidential": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "pkceCodeChallengeMethod": "S256",
      "redirectUris": ["{{UI4A_ORIGIN}}/api/auth/callback"],
      "postLogoutRedirectUris": ["{{UI4A_ORIGIN}}/"],
      "secretRef": "oidc-client-secret",
      "audiences": ["ui4a-api"],
      "defaultScopes": ["openid", "profile", "email", "ui4a:read", "ui4a:write"],
      "optionalScopes": [
        "ui4a:approve",
        "default",
        "publishing",
        "community",
        "development",
        "editorial",
        "governance"
      ]
    },
    {
      "clientId": "ui4a-agent",
      "clientKind": "service-account",
      "confidential": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "secretRef": "ui4a-agent-client-secret",
      "standardTokenExchangeEnabled": true,
      "audiences": ["ui4a-api"],
      "defaultScopes": ["ui4a:read", "ui4a:write"],
      "optionalScopes": [
        "default",
        "publishing",
        "community",
        "development",
        "editorial",
        "governance"
      ]
    },
    {
      "clientId": "ui4a-api",
      "clientKind": "resource-server",
      "confidential": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "audiences": ["ui4a-api"],
      "defaultScopes": ["ui4a:read"],
      "optionalScopes": [
        "ui4a:write",
        "ui4a:approve",
        "default",
        "publishing",
        "community",
        "development",
        "editorial",
        "governance"
      ]
    }
  ],
  "roles": [
    {
      "name": "ui4a-human",
      "scopes": [
        "ui4a:read",
        "ui4a:write",
        "ui4a:approve",
        "default",
        "publishing",
        "community",
        "development",
        "editorial",
        "governance"
      ],
      "humanApprovalEligible": true
    },
    {
      "name": "ui4a-agent",
      "scopes": [
        "ui4a:read",
        "ui4a:write",
        "default",
        "publishing",
        "community",
        "development",
        "editorial",
        "governance"
      ],
      "humanApprovalEligible": false
    },
    {
      "name": "ui4a-service",
      "scopes": [
        "ui4a:read",
        "ui4a:write",
        "default",
        "publishing",
        "community",
        "development",
        "editorial",
        "governance"
      ],
      "humanApprovalEligible": false
    }
  ],
  "fixtureUsers": [
    {
      "username": "ui4a-experiment-human",
      "role": "ui4a-human",
      "passwordSecretRef": "ui4a-experiment-human-password"
    }
  ],
  "bearerConsumers": {
    "cli": {
      "flow": "externally-provisioned-bearer",
      "audience": "ui4a-api",
      "dedicatedClient": false
    }
  }
}
