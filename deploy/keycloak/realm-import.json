{
  "realm": "ui4a",
  "enabled": true,
  "offlineSessionIdleTimeout": 7776000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 15552000,
  "attributes": {
    "ui4a.experimental.contract.version": "2"
  },
  "clientScopes": [
    {
      "name": "ui4a:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:approve",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:default",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:publishing",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:community",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:development",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:editorial",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:governance",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:account-console",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "user.attribute": "foo",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ui4a-web",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["{{UI4A_ORIGIN}}/api/auth/callback"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "{{UI4A_ORIGIN}}/*"
      },
      "defaultClientScopes": ["ui4a:read", "ui4a:write", "ui4a:approve"],
      "optionalClientScopes": [
        "ui4a:policy:default",
        "ui4a:policy:publishing",
        "ui4a:policy:community",
        "ui4a:policy:development",
        "ui4a:policy:editorial",
        "ui4a:policy:governance"
      ],
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "ui4a-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ui4a-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "ui4a-agent-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ui4a-agent",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "secret": "{{secret:oidc-client-secret}}"
    },
    {
      "clientId": "ui4a-agent",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": ["ui4a:read", "ui4a:write"],
      "optionalClientScopes": [
        "ui4a:policy:default",
        "ui4a:policy:publishing",
        "ui4a:policy:community",
        "ui4a:policy:development",
        "ui4a:policy:editorial",
        "ui4a:policy:governance"
      ],
      "protocolMappers": [
        {
          "name": "ui4a-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ui4a-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "secret": "{{secret:ui4a-agent-client-secret}}"
    },
    {
      "clientId": "ui4a-cli",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "access.token.lifespan": "86400",
        "client.offline.session.idle.timeout": "7776000",
        "client.offline.session.max.lifespan": "15552000"
      },
      "defaultClientScopes": ["ui4a:read", "ui4a:write"],
      "optionalClientScopes": [
        "offline_access",
        "ui4a:policy:default",
        "ui4a:policy:publishing",
        "ui4a:policy:community",
        "ui4a:policy:development",
        "ui4a:policy:editorial",
        "ui4a:policy:governance"
      ],
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "ui4a-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ui4a-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ui4a-api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["ui4a:read"],
      "optionalClientScopes": [
        "ui4a:write",
        "ui4a:approve",
        "ui4a:policy:default",
        "ui4a:policy:publishing",
        "ui4a:policy:community",
        "ui4a:policy:development",
        "ui4a:policy:editorial",
        "ui4a:policy:governance"
      ]
    }
  ],
  "users": [
    {
      "username": "ui4a-experiment-human",
      "enabled": true,
      "realmRoles": ["offline_access"],
      "credentials": [
        {
          "type": "password",
          "value": "{{secret:ui4a-experiment-human-password}}",
          "temporary": false
        }
      ]
    }
  ]
}
