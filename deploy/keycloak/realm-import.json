{
  "realm": "ui4a",
  "enabled": true,
  "clientScopes": [
    {
      "name": "ui4a:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:approve",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:default",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:publishing",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:community",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:development",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:editorial",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ui4a:policy:governance",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "clients": [
    {
      "clientId": "ui4a-web",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["{{UI4A_ORIGIN}}/api/auth/callback"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "{{UI4A_ORIGIN}}/*"
      },
      "defaultClientScopes": ["profile", "email", "ui4a:read", "ui4a:write", "ui4a:approve"],
      "optionalClientScopes": [
        "ui4a:policy:default",
        "ui4a:policy:publishing",
        "ui4a:policy:community",
        "ui4a:policy:development",
        "ui4a:policy:editorial",
        "ui4a:policy:governance"
      ],
      "protocolMappers": [
        {
          "name": "ui4a-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ui4a-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "ui4a-agent-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ui4a-agent",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "secret": "{{secret:oidc-client-secret}}"
    },
    {
      "clientId": "ui4a-agent",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": ["ui4a:read", "ui4a:write"],
      "optionalClientScopes": [
        "ui4a:policy:default",
        "ui4a:policy:publishing",
        "ui4a:policy:community",
        "ui4a:policy:development",
        "ui4a:policy:editorial",
        "ui4a:policy:governance"
      ],
      "protocolMappers": [
        {
          "name": "ui4a-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ui4a-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "secret": "{{secret:ui4a-agent-client-secret}}"
    },
    {
      "clientId": "ui4a-api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["ui4a:read"],
      "optionalClientScopes": [
        "ui4a:write",
        "ui4a:approve",
        "ui4a:policy:default",
        "ui4a:policy:publishing",
        "ui4a:policy:community",
        "ui4a:policy:development",
        "ui4a:policy:editorial",
        "ui4a:policy:governance"
      ]
    }
  ],
  "users": [
    {
      "username": "ui4a-experiment-human",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "{{secret:ui4a-experiment-human-password}}",
          "temporary": false
        }
      ]
    }
  ]
}
