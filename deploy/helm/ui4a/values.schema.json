{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "namespace",
    "experimental",
    "scheduling",
    "network",
    "hosts",
    "images",
    "imagePullPolicy",
    "serviceAccounts",
    "secrets",
    "storage",
    "backup",
    "istio"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "istioInjection"],
      "properties": {
        "create": { "const": true },
        "name": { "$ref": "#/definitions/name" },
        "istioInjection": { "const": true }
      }
    },
    "experimental": {
      "type": "object",
      "additionalProperties": false,
      "required": ["highAvailability", "replicas"],
      "properties": {
        "highAvailability": { "const": false },
        "replicas": { "const": 1 }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeSelector"],
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostAliases"],
      "properties": {
        "hostAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ip", "hostnames"],
            "properties": {
              "ip": {
                "type": "string",
                "oneOf": [{ "format": "ipv4" }, { "format": "ipv6" }]
              },
              "hostnames": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/definitions/hostname" }
              }
            }
          }
        }
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "keycloak"],
      "properties": {
        "web": { "$ref": "#/definitions/hostname" },
        "keycloak": { "$ref": "#/definitions/hostname" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres",
        "temporal",
        "temporalAdminTools",
        "temporalUi",
        "keycloak",
        "web",
        "worker",
        "runner",
        "adminWorker",
        "pkiRunner"
      ],
      "properties": {
        "postgres": { "$ref": "#/definitions/image" },
        "temporal": { "$ref": "#/definitions/image" },
        "temporalAdminTools": { "$ref": "#/definitions/image" },
        "temporalUi": { "$ref": "#/definitions/image" },
        "keycloak": { "$ref": "#/definitions/image" },
        "web": { "$ref": "#/definitions/image" },
        "worker": { "$ref": "#/definitions/image" },
        "runner": { "$ref": "#/definitions/image" },
        "adminWorker": { "$ref": "#/definitions/image" },
        "pkiRunner": { "$ref": "#/definitions/image" }
      }
    },
    "imagePullPolicy": { "const": "IfNotPresent" },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres",
        "temporal",
        "keycloak",
        "web",
        "worker",
        "runner",
        "admin",
        "backup"
      ],
      "properties": {
        "postgres": { "$ref": "#/definitions/name" },
        "temporal": { "$ref": "#/definitions/name" },
        "keycloak": { "$ref": "#/definitions/name" },
        "web": { "$ref": "#/definitions/name" },
        "worker": { "$ref": "#/definitions/name" },
        "runner": { "$ref": "#/definitions/name" },
        "admin": { "$ref": "#/definitions/name" },
        "backup": { "$ref": "#/definitions/name" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecretName", "runnerExistingSecretName", "runnerSecretsKey"],
      "properties": {
        "existingSecretName": { "$ref": "#/definitions/name" },
        "runnerExistingSecretName": { "$ref": "#/definitions/name" },
        "runnerSecretsKey": { "$ref": "#/definitions/secretKey" }
      }
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "storageClassName", "sizes"],
          "properties": {
            "mode": { "const": "dynamic" },
            "storageClassName": { "$ref": "#/definitions/name" },
            "sizes": { "$ref": "#/definitions/sizes" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "volumes"],
          "properties": {
            "mode": { "const": "static" },
            "storageClassName": { "$ref": "#/definitions/name" },
            "sizes": { "$ref": "#/definitions/sizes" },
            "volumes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["postgres", "runtime", "backup", "pki"],
              "properties": {
                "postgres": { "$ref": "#/definitions/staticVolume" },
                "runtime": { "$ref": "#/definitions/staticVolume" },
                "backup": { "$ref": "#/definitions/staticVolume" },
                "pki": { "$ref": "#/definitions/staticVolume" }
              }
            }
          }
        }
      ]
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule"],
      "properties": { "schedule": { "type": "string", "minLength": 9 } }
    },
    "istio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "tlsCredentialName", "oidcIssuer", "oidcAudience", "jwksUri"],
      "properties": {
        "gateway": { "$ref": "#/definitions/name" },
        "tlsCredentialName": { "$ref": "#/definitions/name" },
        "oidcIssuer": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#]+/realms/ui4a$"
        },
        "oidcAudience": { "$ref": "#/definitions/name" },
        "jwksUri": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "secretKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "maxLength": 253
    },
    "hostname": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "image": {
      "type": "string",
      "pattern": "^[^[:space:]]+@sha256:[a-f0-9]{64}$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"
    },
    "sizes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgres", "runtime", "backup", "pki"],
      "properties": {
        "postgres": { "$ref": "#/definitions/quantity" },
        "runtime": { "$ref": "#/definitions/quantity" },
        "backup": { "$ref": "#/definitions/quantity" },
        "pki": { "$ref": "#/definitions/quantity" }
      }
    },
    "staticVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volumeName", "capacity", "hostPath", "nodeName"],
      "properties": {
        "volumeName": { "$ref": "#/definitions/name" },
        "capacity": { "$ref": "#/definitions/quantity" },
        "hostPath": { "type": "string", "pattern": "^/[^[:cntrl:]]+$" },
        "nodeName": { "$ref": "#/definitions/hostname" }
      }
    }
  }
}
