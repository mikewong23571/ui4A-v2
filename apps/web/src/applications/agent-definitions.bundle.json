{
  "schemaVersion": 1,
  "definitions": [
    {
      "schemaVersion": 1,
      "ref": "base-agent@1",
      "name": "base-agent",
      "version": 1,
      "intent": "Complete one authorized task within explicit runtime, tool, resource, and result contracts.",
      "prompt": {
        "schemaVersion": 1,
        "blocks": [
          {
            "id": "base-authority",
            "role": "system",
            "purpose": "authority",
            "literal": "You are operating inside UI4A. Use only the supplied grants. Return proposed work and evidence; never approve, activate, publish, merge, push, or deploy it yourself.",
            "sealed": true
          }
        ]
      },
      "contracts": {
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" }
      },
      "runtimeRequirements": {
        "class": "general-agent",
        "features": ["structured-events"]
      },
      "policies": {
        "tools": { "allowed": [] },
        "context": { "allowedSources": [], "maxItems": 0 },
        "resources": { "allowed": [] },
        "artifacts": {
          "allowedMediaTypes": ["application/json"],
          "maxCount": 8,
          "maxBytes": 1048576
        }
      },
      "evaluationPolicy": {
        "verifiers": ["schema"],
        "evalSuiteRefs": ["eval:base-agent@1"],
        "minimumScore": 1
      }
    },
    {
      "schemaVersion": 1,
      "ref": "coding-agent@1",
      "name": "coding-agent",
      "version": 1,
      "extends": "base-agent@1",
      "specialize": {
        "replace": {
          "intent": "Implement an authorized software change in a UI4A-owned isolated Git worktree and return independently verifiable code, test, and trajectory evidence.",
          "contracts": {
            "inputSchema": {
              "type": "object",
              "properties": {
                "kind": { "const": "coding-task" },
                "codingTask": { "type": "object" },
                "compiledPrompt": {
                  "type": "object",
                  "properties": {
                    "messages": { "type": "array" },
                    "compiledHash": { "type": "string" }
                  },
                  "required": ["messages", "compiledHash"],
                  "additionalProperties": false
                }
              },
              "required": ["kind", "codingTask", "compiledPrompt"],
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "properties": { "codingResult": { "type": "object" } },
              "required": ["codingResult"],
              "additionalProperties": false
            }
          },
          "runtimeRequirements": {
            "class": "coding-agent",
            "features": ["resume", "structured-events", "workspace-write"]
          },
          "policies": {
            "tools": { "allowed": ["filesystem", "git", "shell"] },
            "context": { "allowedSources": ["repository"], "maxItems": 16 },
            "resources": { "allowed": ["repository"] },
            "artifacts": {
              "allowedMediaTypes": ["application/json", "application/x-ndjson", "text/x-diff"],
              "maxCount": 64,
              "maxBytes": 4194304
            }
          },
          "evaluationPolicy": {
            "verifiers": ["git-diff", "test-observation"],
            "evalSuiteRefs": ["eval:t18-real-codex@1"],
            "minimumScore": 1
          }
        },
        "appendPromptBlocks": [
          {
            "id": "coding-method",
            "role": "system",
            "purpose": "instruction",
            "literal": "Work from the requested base revision in the isolated worktree. Inspect before editing, stay within allowed paths, run the stated acceptance tests, and report the observed result. Do not commit or operate the main checkout."
          },
          {
            "id": "coding-task",
            "role": "user",
            "purpose": "task-data",
            "binding": {
              "source": "task",
              "pointer": "/codingTask",
              "encoding": "json-delimited",
              "required": true
            }
          }
        ]
      }
    },
    {
      "schemaVersion": 1,
      "ref": "writing-agent@1",
      "name": "writing-agent",
      "version": 1,
      "extends": "base-agent@1",
      "specialize": {
        "replace": {
          "intent": "Compose an evidence-grounded Markdown document from an authorized brief and immutable sources, then return independently verifiable citation, artifact, and render evidence without publishing it.",
          "contracts": {
            "inputSchema": {
              "type": "object",
              "properties": {
                "kind": { "const": "writing-task" },
                "writingBrief": {
                  "type": "object",
                  "properties": {
                    "schemaVersion": { "const": 1 },
                    "objective": { "type": "string", "minLength": 1 },
                    "audience": { "type": "string", "minLength": 1 },
                    "format": { "const": "markdown" },
                    "requiredSections": { "type": "array", "items": { "type": "string" } },
                    "constraints": { "type": "array", "items": { "type": "string" } },
                    "allowedOutputPaths": { "type": "array", "items": { "type": "string" } },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "minLength": 1 },
                          "title": { "type": "string", "minLength": 1 },
                          "mediaType": {
                            "enum": ["text/plain", "text/markdown", "application/json"]
                          },
                          "content": { "type": "string" },
                          "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                        },
                        "required": ["id", "title", "mediaType", "content", "hash"],
                        "additionalProperties": false
                      }
                    },
                    "citationPolicy": {
                      "type": "object",
                      "properties": {
                        "style": { "const": "paragraph-markers" },
                        "requireEveryFactualParagraph": { "type": "boolean" }
                      },
                      "required": ["style", "requireEveryFactualParagraph"],
                      "additionalProperties": false
                    },
                    "budget": {
                      "type": "object",
                      "properties": {
                        "timeoutSeconds": { "type": "integer", "minimum": 1 },
                        "maxTurns": { "type": "integer", "minimum": 1 },
                        "maxRawEvents": { "type": "integer", "minimum": 1 },
                        "maxRawBytes": { "type": "integer", "minimum": 1 },
                        "maxRawChunkBytes": { "type": "integer", "minimum": 1 }
                      },
                      "required": [
                        "timeoutSeconds",
                        "maxTurns",
                        "maxRawEvents",
                        "maxRawBytes",
                        "maxRawChunkBytes"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "objective",
                    "audience",
                    "format",
                    "requiredSections",
                    "constraints",
                    "allowedOutputPaths",
                    "sources",
                    "citationPolicy",
                    "budget"
                  ],
                  "additionalProperties": false
                },
                "compiledPrompt": {
                  "type": "object",
                  "properties": {
                    "messages": { "type": "array" },
                    "compiledHash": { "type": "string" }
                  },
                  "required": ["messages", "compiledHash"],
                  "additionalProperties": false
                }
              },
              "required": ["kind", "writingBrief", "compiledPrompt"],
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "properties": { "writingResult": { "type": "object" } },
              "required": ["writingResult"],
              "additionalProperties": false
            }
          },
          "runtimeRequirements": {
            "class": "document-agent",
            "features": [
              "structured-result",
              "streamed-events",
              "cancel",
              "resume",
              "document-workspace",
              "artifact-write"
            ]
          },
          "policies": {
            "tools": {
              "allowed": ["source-read", "artifact-write", "artifact-hash", "word-count"]
            },
            "context": { "allowedSources": ["writing-sources"], "maxItems": 32 },
            "resources": { "allowed": ["document-workspace", "writing-sources"] },
            "artifacts": {
              "allowedMediaTypes": ["text/markdown", "application/json"],
              "maxCount": 16,
              "maxBytes": 4194304
            }
          },
          "evaluationPolicy": {
            "verifiers": [
              "writing-result-schema",
              "document-workspace",
              "source-integrity",
              "artifact-integrity",
              "citation-coverage",
              "markdown-render",
              "forbidden-writing-effects"
            ],
            "evalSuiteRefs": ["eval:t19-writing-agent@1"],
            "minimumScore": 0.8
          }
        },
        "appendPromptBlocks": [
          {
            "id": "writing-method",
            "role": "system",
            "purpose": "instruction",
            "literal": "Compose only from the supplied brief and immutable sources. Cite factual paragraphs with declared source markers, write only the authorized Markdown artifact, and return evidence. Never modify a repository or publish the result."
          },
          {
            "id": "writing-task",
            "role": "user",
            "purpose": "task-data",
            "binding": {
              "source": "task",
              "pointer": "/writingBrief",
              "encoding": "json-delimited",
              "required": true
            }
          }
        ]
      }
    },
    {
      "schemaVersion": 1,
      "ref": "agent-definition-author@1",
      "name": "agent-definition-author",
      "version": 1,
      "extends": "base-agent@1",
      "specialize": {
        "replace": {
          "intent": "Turn a natural-language specialization request and the bounded Agent Definition registry contract into a mechanically reviewable Agent Definition Draft, examples, and Eval corpus without approving or activating it.",
          "contracts": {
            "inputSchema": {
              "type": "object",
              "properties": {
                "kind": { "const": "agent-definition-authoring-task" },
                "authoringBrief": {
                  "type": "object",
                  "properties": {
                    "schemaVersion": { "const": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "requestedRef": { "type": "string" },
                    "constraints": { "type": "array", "items": { "type": "string" } },
                    "registry": {
                      "type": "object",
                      "properties": {
                        "runtimeClasses": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" },
                              "features": { "type": "array", "items": { "type": "string" } }
                            },
                            "required": ["name", "features"],
                            "additionalProperties": false
                          }
                        },
                        "tools": { "type": "array", "items": { "type": "string" } },
                        "resources": { "type": "array", "items": { "type": "string" } },
                        "contextSources": { "type": "array", "items": { "type": "string" } },
                        "verifiers": { "type": "array", "items": { "type": "string" } },
                        "baseDefinitions": { "type": "array", "items": { "type": "object" } }
                      },
                      "required": [
                        "runtimeClasses",
                        "tools",
                        "resources",
                        "contextSources",
                        "verifiers",
                        "baseDefinitions"
                      ],
                      "additionalProperties": false
                    },
                    "budget": {
                      "type": "object",
                      "properties": {
                        "timeoutSeconds": { "type": "integer", "minimum": 1 },
                        "maxTurns": { "type": "integer", "minimum": 1 },
                        "maxRawEvents": { "type": "integer", "minimum": 1 },
                        "maxRawBytes": { "type": "integer", "minimum": 1 },
                        "maxRawChunkBytes": { "type": "integer", "minimum": 1 }
                      },
                      "required": [
                        "timeoutSeconds",
                        "maxTurns",
                        "maxRawEvents",
                        "maxRawBytes",
                        "maxRawChunkBytes"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": ["schemaVersion", "description", "constraints", "registry", "budget"],
                  "additionalProperties": false
                },
                "compiledPrompt": {
                  "type": "object",
                  "properties": {
                    "messages": { "type": "array" },
                    "compiledHash": { "type": "string" }
                  },
                  "required": ["messages", "compiledHash"],
                  "additionalProperties": false
                }
              },
              "required": ["kind", "authoringBrief", "compiledPrompt"],
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "authoringResult": { "type": "object" }
              },
              "required": ["authoringResult"],
              "additionalProperties": false
            }
          },
          "runtimeRequirements": {
            "class": "agent-definition-authoring",
            "features": ["structured-result", "streamed-events", "cancel", "resume"]
          },
          "policies": {
            "tools": { "allowed": [] },
            "context": { "allowedSources": [], "maxItems": 0 },
            "resources": { "allowed": [] },
            "artifacts": {
              "allowedMediaTypes": ["application/json"],
              "maxCount": 16,
              "maxBytes": 4194304
            }
          },
          "evaluationPolicy": {
            "verifiers": [
              "agent-definition-source-parse",
              "agent-definition-non-eval-invariants",
              "agent-definition-eval-corpus-proposed",
              "agent-definition-draft-only"
            ],
            "evalSuiteRefs": ["eval:t19-agent-definition-author@1"],
            "minimumScore": 0.8
          }
        },
        "appendPromptBlocks": [
          {
            "id": "agent-definition-authoring-method",
            "role": "system",
            "purpose": "instruction",
            "literal": "Draft a provider-neutral Agent Definition from the supplied request. Include typed Prompt blocks, input/output schemas, runtime requirements, least-privilege policies, examples, and a bounded Eval corpus. You cannot approve or activate this output; it must enter the governed Draft lifecycle for mechanical checks, diff, Eval evidence, and a human decision."
          },
          {
            "id": "agent-definition-authoring-task",
            "role": "user",
            "purpose": "task-data",
            "binding": {
              "source": "task",
              "pointer": "/authoringBrief",
              "encoding": "json-delimited",
              "required": true
            }
          }
        ]
      }
    }
  ],
  "policyScopes": {
    "base-agent@1": ["development", "editorial", "governance"],
    "coding-agent@1": ["development"],
    "writing-agent@1": ["editorial"],
    "agent-definition-author@1": ["governance"]
  },
  "evaluation": {
    "base-agent@1": {
      "kind": "system-seed-evidence",
      "suite": "eval:base-agent@1",
      "passed": true,
      "score": 1
    },
    "coding-agent@1": {
      "kind": "system-seed-evidence",
      "suite": "eval:t18-real-codex@1",
      "passed": true,
      "score": 1,
      "source": "conductor/tracks/t18-coding-capability-executors_20260823/eval-report.json"
    },
    "writing-agent@1": {
      "kind": "system-seed-evidence",
      "suite": "eval:t19-writing-agent@1",
      "passed": true,
      "score": 1,
      "source": "conductor/tracks/t19-specialized-agent-contracts_20260823/writing-eval-report.json"
    },
    "agent-definition-author@1": {
      "kind": "system-seed-evidence",
      "suite": "eval:t19-agent-definition-author@1",
      "passed": true,
      "score": 1,
      "source": "conductor/tracks/t19-specialized-agent-contracts_20260823/authoring-eval-report.json"
    }
  }
}
