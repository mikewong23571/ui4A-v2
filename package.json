{
  "name": "ui4a",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @ui4a/web dev",
    "dev:worker": "pnpm --filter @ui4a/worker dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "CI=true playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@ui4a/agent": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "fast-check": "^4.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
