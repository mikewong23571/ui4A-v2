{
  "name": "ui4a",
  "version": "0.1.0-experimental.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @ui4a/web dev",
    "dev:web": "PORT=3100 pnpm --filter @ui4a/web dev",
    "dev:temporal": "temporal server start-dev --port 7233 --db-filename /tmp/ui4a-temporal.db",
    "dev:worker": "pnpm --filter @ui4a/worker dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "predev:all": "pnpm infra:up",
    "dev:all": "node scripts/with-local-env.mjs concurrently --kill-others-on-fail --names temporal,worker,web --prefix-colors cyan,magenta,green \"pnpm dev:temporal\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "env:verify-dev": "node scripts/verify-dev-env.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "CI=true playwright test",
    "eval:t15": "CI=true playwright test --config=playwright.story-eval.config.ts",
    "eval:t16": "CI=true playwright test --config=playwright.t16-eval.config.ts",
    "cli:build": "pnpm --filter @ui4a/cli build",
    "cli:pack": "pnpm --filter @ui4a/cli pack",
    "eval:t17": "node scripts/t17-eval.mjs",
    "eval:t18": "pnpm exec tsx scripts/t18-real-eval.ts",
    "eval:t19:writing": "pnpm exec tsx scripts/t19-writing-real-eval.ts",
    "eval:t19:authoring": "pnpm exec tsx scripts/t19-authoring-real-eval.ts",
    "migrate:production": "pnpm --filter @ui4a/worker exec tsx ../../scripts/t22-migrate.ts",
    "compose:t22": "pnpm --filter @ui4a/worker exec tsx ../../scripts/t22-compose.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@ui4a/agent": "workspace:*",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "fast-check": "^4.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
