# UI4A 环境变量样例(复制为 .env 使用)
# 注:DATABASE_URL 自 T1 Phase 2 起启用,指向 docker compose 的 postgres 服务;
# 宿主端口 5433 固定映射容器内 5432(docker compose up -d --wait)。
DATABASE_URL=postgres://ui4a:ui4a@localhost:5433/ui4a

# Provider-neutral LLM configuration. Put local values in the root .env.local;
# pnpm dev:all passes them to both the web and worker processes.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Specialized Agent Runtime Profiles. Provider/model/endpoint/credential names are deployment data;
# requests and Application Bundles cannot override them.
UI4A_DOCUMENT_AGENT_PROFILES=[]
UI4A_DOCUMENT_WORKSPACE_ROOT=/absolute/ui4a-document-workspaces
UI4A_AGENT_AUTHORING_PROFILES=[]
UI4A_AGENT_AUTHORING_RUNTIME_ROOT=/absolute/ui4a-authoring-runs
UI4A_CODING_EXECUTOR_PROFILES=[]
UI4A_CODING_REPOSITORIES={}
UI4A_CODING_WORKSPACE_ROOT=/absolute/ui4a-coding-workspaces
UI4A_CAPABILITY_CALLBACK_TOKEN=
UI4A_PUBLIC_BASE_URL=http://localhost:3100
